{
  "name": "[Vault] GitHub PR AI Security & Bug Reviewer",
  "nodes": [
    {
      "parameters": {
        "content": "## 11 · GitHub PR AI Security & Bug Reviewer\n**Trigger:** GitHub Pull Request webhook `/webhook/vault-github-pr`\n**Env Vars:** `GITHUB_TOKEN`, `OPENAI_API_KEY`\nFetches changed files of opened/synchronized PRs, audits for security/logic bugs, and posts a structured review comment back to GitHub.",
        "height": 220,
        "width": 460,
        "color": 4
      },
      "id": "a3d5f2ce-b427-5ad2-bed8-82ab81d379cd",
      "name": "Setup Guide",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vault-github-pr",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "8e37cbfe-1f6f-5f80-9cc8-d172e2a8d20f",
      "name": "Incoming Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        320
      ],
      "webhookId": "e1350ea8-d2a3-5b10-aa4b-862f2ab07cd9"
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json.body || $input.first().json;\nconst action = p.action || \"\";\nconst pr = p.pull_request || {};\nconst repo = p.repository?.full_name || \"\";\nif (![\"opened\", \"synchronize\", \"reopened\"].includes(action) || !repo || !pr.number) {\n  return [];\n}\nreturn [{\n  json: {\n    repo,\n    prNumber: pr.number,\n    title: pr.title || \"\",\n    author: pr.user?.login || \"unknown\",\n    filesUrl: `https://api.github.com/repos/${repo}/pulls/${pr.number}/files?per_page=30`,\n    commentUrl: `https://api.github.com/repos/${repo}/issues/${pr.number}/comments`,\n  }\n}];"
      },
      "id": "eb39f796-c0f3-50e6-b1f2-205288b61c6e",
      "name": "Filter Opened/Sync PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.filesUrl }}",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "id": "5454ef0e-72be-590e-9e2c-ea85347baefa",
      "name": "Fetch PR Diff Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Filter Opened/Sync PRs').first().json;\nconst files = $input.all().map((i) => i.json).flat();\nconst patchSummary = files.slice(0, 12).map((f) => `FILE: ${f.filename} (+${f.additions}/-${f.deletions})\\n${String(f.patch || '').slice(0, 1200)}`).join('\\n---\\n').slice(0, 10000);\nreturn [{ json: { ...meta, patchSummary } }];"
      },
      "id": "ac5a43da-a0b0-5f7e-b680-56f9077fae05",
      "name": "Compact Diff Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.OPENAI_BASE_URL || \"https://api.openai.com/v1\") + \"/chat/completions\" }}",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_MODEL || \"gpt-4o-mini\", temperature: 0.2, response_format: { type: \"json_object\" }, messages: [ { role: \"system\", content: \"You are a staff security & code reviewer. Review the diff concisely for concrete bugs, race conditions, security flaws (XSS, SQLi, auth bypass, secret leaks). Do not nitpick style. Return JSON: { riskLevel: 'LOW'|'MEDIUM'|'HIGH', markdownComment: string }.\" }, { role: \"user\", content: JSON.stringify({ title: $json.title, diff: $json.patchSummary }) } ] }) }}"
      },
      "id": "c2f20dfe-06d2-581d-a4df-6f32b2accf8d",
      "name": "AI Security & Bug Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Filter Opened/Sync PRs').first().json;\nconst raw = $input.first().json?.choices?.[0]?.message?.content || '{}';\nlet ai = { riskLevel: 'LOW', markdownComment: 'No critical issues detected.' };\ntry { ai = { ...ai, ...JSON.parse(raw) }; } catch {}\nreturn [{ json: { commentUrl: meta.commentUrl, body: `### 🛡️ Automated PR Review (Risk: **${ai.riskLevel}**)\\n\\n${ai.markdownComment}` } }];"
      },
      "id": "e5805412-ba37-590b-add6-1b3fb9581f82",
      "name": "Prepare GitHub Comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.commentUrl }}",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: $json.body }) }}"
      },
      "id": "83ed937c-6a42-5508-9ed7-e44915dc3d37",
      "name": "Post Comment to GitHub PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        320
      ]
    }
  ],
  "connections": {
    "Incoming Webhook": {
