            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Revenue KPIs": {
      "main": [
        [
          {
            "node": "Send Executive Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
