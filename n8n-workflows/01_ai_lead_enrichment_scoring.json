{
  "name": "[Vault] AI Lead Enrichment & ICP Scoring Router",
  "nodes": [
    {
      "parameters": {
        "content": "## 01 · AI Lead Enrichment & ICP Scoring\n**Trigger:** POST `/webhook/vault-lead-score`\n**Payload:** `{ email, name, company, website, message }`\n**Env Vars:** `OPENAI_API_KEY`, `SLACK_WEBHOOK_URL`, `CRM_WEBHOOK_URL`\nScores leads 0–100 against your ICP and pings Slack immediately for hot leads (>= 75).",
        "height": 220,
        "width": 460,
        "color": 4
      },
      "id": "a1e0b34f-0d49-5cc2-b67e-985e0dcfd164",
      "name": "Setup Guide",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vault-lead-score",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "213b6f96-eb80-594b-9bd3-6b4774b5fc8c",
      "name": "Incoming Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        320
      ],
      "webhookId": "4e139e20-7e1b-55c5-97b1-4def602c9bbc"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst email = String(b.email || \"\").trim().toLowerCase();\nconst domain = email.includes(\"@\") ? email.split(\"@\")[1] : \"\";\nconst freeDomains = new Set([\"gmail.com\", \"yahoo.com\", \"hotmail.com\", \"outlook.com\"]);\nreturn [{\n  json: {\n    name: String(b.name || \"Unknown\").trim(),\n    email,\n    company: String(b.company || domain || \"Unknown\").trim(),\n    website: String(b.website || (domain && !freeDomains.has(domain) ? `https://${domain}` : \"\")).trim(),\n    isCorporateEmail: Boolean(domain && !freeDomains.has(domain)),\n    message: String(b.message || \"\").slice(0, 1500),\n    receivedAt: new Date().toISOString(),\n  }\n}];"
      },
      "id": "b214bf03-b55d-58a4-a508-0f6626665b14",
      "name": "Normalize Lead Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.OPENAI_BASE_URL || \"https://api.openai.com/v1\") + \"/chat/completions\" }}",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_MODEL || \"gpt-4o-mini\", temperature: 0.2, response_format: { type: \"json_object\" }, messages: [ { role: \"system\", content: \"You are a B2B revenue operations analyst. Return JSON: { score: number (0-100), tier: 'HOT'|'WARM'|'COLD', summary: string, recommendedNextAction: string, personalizedOpeningLine: string }.\" }, { role: \"user\", content: JSON.stringify($json) } ] }) }}"
      },
      "id": "080664e9-a91e-5280-a0e8-676f91427f89",
      "name": "AI ICP Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Lead Payload').first().json;\nconst raw = $input.first().json?.choices?.[0]?.message?.content || '{}';\nlet ai = { score: 0, tier: 'COLD', summary: 'Parse fallback', recommendedNextAction: 'Review manually' };\ntry { ai = { ...ai, ...JSON.parse(raw) }; } catch {}\nreturn [{ json: { ...lead, ...ai, score: Number(ai.score) || 0 } }];"
      },
      "id": "19323401-83c0-5444-a211-a48cf5960d45",
      "name": "Parse Score & Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "109a43af-8b50-5d87-8dc7-b4e85ef93352",
              "leftValue": "={{ $json.score }}",
              "rightValue": 75,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "4411c657-9004-5680-b1eb-ede6487a2e36",
      "name": "Is Hot Lead (>=75)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1180,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `🔥 HOT LEAD (${$json.score}/100): *${$json.name}* (${$json.company}) — ${$json.email}\\n*Summary:* ${$json.summary}\\n*Next:* ${$json.recommendedNextAction}` }) }}"
      },
      "id": "897e8f61-19b5-5cc8-86dd-904e0da12dc3",
      "name": "Alert Sales Slack (HOT)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_WEBHOOK_URL || \"https://httpbin.org/post\" }}",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "8fcb1445-a27b-5e9e-91cb-6e2c93b0ae3b",
      "name": "Log Warm/Cold to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        420
      ]
    }
  ],
